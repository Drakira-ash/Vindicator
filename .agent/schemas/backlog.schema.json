{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vindicator task backlog",
  "type": "object",
  "required": ["schema_version", "updated_at", "tasks"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "updated_at": {"type": "string"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "priority", "source", "description", "acceptance_criteria", "blockers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["candidate", "planned", "in_progress", "blocked", "deferred", "done"]},
          "priority": {"type": "integer", "minimum": 0, "maximum": 5},
          "source": {"type": "string"},
          "description": {"type": "string"},
          "acceptance_criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "blockers": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
