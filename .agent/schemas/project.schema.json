{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vindicator harness project metadata",
  "type": "object",
  "required": ["schema_version", "name", "kind", "engine", "language", "paths", "commands", "index"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "kind": {"type": "string", "enum": ["unity-game", "game", "software"]},
    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "editor": {"type": "string"},
        "render_pipeline": {"type": "string"}
      }
    },
    "language": {"type": "string"},
    "git": {
      "type": "object",
      "properties": {
        "remote": {"type": "string"},
        "main_branch": {"type": "string"},
        "bootstrap_branch": {"type": "string"},
        "bootstrap_commit": {"type": "string"}
      }
    },
    "paths": {
      "type": "object",
      "required": ["scripts", "scenes", "harness"],
      "additionalProperties": {
        "anyOf": [
          {"type": "string"},
          {"type": "array", "items": {"type": "string"}}
        ]
      }
    },
    "commands": {
      "type": "object",
      "required": ["session_start", "status", "index", "validate"],
      "additionalProperties": {"type": "string"}
    },
    "verification": {"type": "object"},
    "index": {
      "type": "object",
      "required": ["file_roots", "signature_roots", "exclude_rel_prefixes"],
      "properties": {
        "file_roots": {"type": "array", "items": {"type": "string"}},
        "root_files": {"type": "array", "items": {"type": "string"}},
        "signature_roots": {"type": "array", "items": {"type": "string"}},
        "exclude_rel_prefixes": {"type": "array", "items": {"type": "string"}},
        "package_guid_scan": {"type": "string"}
      }
    }
  }
}
